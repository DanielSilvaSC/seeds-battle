{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/node_modules/**",
      "perguntas-parabolas.json",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
